# Copy to .env and fill what you have. Everything is optional:
# with no keys, Portiq runs on the mock LLM + sample/Remotive jobs.

# --- LLM (first key found wins; or set LLM_PROVIDER) ---
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Our own model via the TeachHelp API (OpenAI-compatible). Server-side only:
# never expose it as NEXT_PUBLIC_*. The base URL is a Cloudflare quick tunnel and
# changes every time the TeachHelp server restarts, e.g. https://xxx.trycloudflare.com/v1
TEACHHELP_API_KEY=
TEACHHELP_BASE_URL=
# Local model via Ollama, e.g. http://host.docker.internal:11434
OLLAMA_URL=
# Optional overrides. The Judge should use a different model than the agents.
LLM_MODEL=
LLM_JUDGE_MODEL=

# --- Job sources ---
# https://oapi.saramin.co.kr (apply for a key)
SARAMIN_API_KEY=
# hh.uz uses the hh.ru API: register an app at https://dev.hh.ru
HH_ACCESS_TOKEN=
# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Public job channels, comma-separated, without @
TG_CHANNELS=
REMOTIVE_ENABLED=true
SEED_ENABLED=true
SOURCE_INTERVAL_MIN=60
